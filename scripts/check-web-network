#!/usr/bin/env python3
"""Read-only overlap check before creating the PeaNUT bridge on Linux."""

import ipaddress
import json
import socket
import subprocess
import sys

subnet = ipaddress.ip_network(sys.argv[1])
gateway = ipaddress.ip_address(sys.argv[2])
if subnet.version != 4 or gateway not in subnet.hosts():
    sys.exit("The PeaNUT gateway must be a usable IPv4 address in its subnet.")


def read_json(*args):
    return json.loads(subprocess.check_output(args, text=True))


for route in read_json("ip", "-j", "-4", "route", "show", "table", "all"):
    destination = route.get("dst", "default")
    if destination == "default":
        continue
    network = ipaddress.ip_network(destination, strict=False)
    if network.overlaps(subnet) and route.get("dev") != "br-peanut":
        sys.exit(f"PeaNUT subnet overlaps route {destination} on {route.get('dev')}.")

network_ids = subprocess.check_output(
    ["docker", "network", "ls", "--quiet"], text=True
).split()
if network_ids:
    for network in read_json("docker", "network", "inspect", *network_ids):
        options = network.get("Options") or {}
        own_bridge = options.get("com.docker.network.bridge.name") == "br-peanut"
        labels = network.get("Labels") or {}
        if own_bridge and (
            labels.get("com.docker.compose.project") != "home-dns"
            or labels.get("com.docker.compose.network") != "peanut_link"
        ):
            sys.exit("br-peanut is already owned by a different Docker network.")
        for config in network.get("IPAM", {}).get("Config") or []:
            existing = ipaddress.ip_network(config["Subnet"])
            if existing.version != 4:
                continue
            if own_bridge:
                if existing != subnet or config.get("Gateway") != str(gateway):
                    sys.exit("Existing PeaNUT bridge uses different addresses; do not recreate it automatically.")
            elif existing.overlaps(subnet):
                sys.exit(f"PeaNUT subnet overlaps Docker network {network['Name']} ({existing}).")

print(f"Private PeaNUT bridge {subnet}, gateway {gateway}: no conflicts found.")

if len(sys.argv) > 3:
    lan_ip = str(ipaddress.ip_address(sys.argv[3]))
    existing_npm = subprocess.run(
        ["docker", "inspect", "nginx-proxy-manager"],
        text=True, capture_output=True, check=False,
    )
    npm_ports = {}
    if existing_npm.returncode == 0:
        container = json.loads(existing_npm.stdout)[0]
        if container.get("State", {}).get("Running"):
            npm_ports = container.get("NetworkSettings", {}).get("Ports") or {}
    for port in (80, 81, 443):
        owned = any(
            binding.get("HostIp") == lan_ip and binding.get("HostPort") == str(port)
            for binding in npm_ports.get(f"{port}/tcp") or []
        )
        if owned:
            continue
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as probe:
            try:
                probe.bind((lan_ip, port))
            except OSError as error:
                sys.exit(f"NPM cannot bind {lan_ip}:{port}: {error.strerror}.")
    print(f"NPM ports on {lan_ip}: available or already owned by NPM.")
