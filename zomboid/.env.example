# The Zomboid playbook creates the private .env on the server.
# For manual setup, copy this file to .env, chmod 600 .env, and fill every blank
# password and LAN_IP before starting. Keep this project separate from home-dns.
ZOMBOID_IMAGE=indifferentbroccoli/projectzomboid-server-docker:v1.1.9@sha256:8e13816b92fdd3e1fac3044b8b9228b255e6deb4d28b268f93a911fbd58ca6e8
LAN_IP=
TZ=Etc/UTC
PUID=1000
PGID=1000
SERVER_NAME=homelab
ADMIN_USERNAME=admin

# Use different long random hexadecimal passwords. The upstream scripts do not
# escape punctuation when writing RCON YAML and server INI settings.
# Admin and RCON passwords are required by Compose; never publish RCON port 27015.
ADMIN_PASSWORD=
RCON_PASSWORD=

# Required by Ansible for Password= in data/server-data/Server/<SERVER_NAME>.ini.
# The image does not read SERVER_PASSWORD. For manual setup, configure this INI
# file before startup with Password, Public=false, UPnP=false, and Open=true.
SERVER_PASSWORD=

MAX_PLAYERS=4
MEMORY_XMX_GB=4
MEMORY_XMS_GB=

# The initial install still downloads the server. Later starts keep that version.
# The image digest pins the launcher; game files are downloaded separately.
UPDATE_ON_START=false
# Leave empty for the public stable branch.
SERVER_BRANCH=
