[Unit]
Description=Apply approved homelab Docker image updates
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/update-homelab-images --apply
ExecStopPost=/usr/local/sbin/update-homelab-images --recover
TimeoutStartSec=2h
TimeoutStopSec=10min
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

