# Copy to .env for CLI use. Enter the application variables separately in
# Portainer when deploying docker-compose.yml from Git. Never commit real values.

# Absolute directory on the Docker host containing configuration and data.
DATA_DIR=/srv/docker
DOMAINNAME=example.com
SERVER_IP=192.0.2.10
TZ=Etc/UTC
PUID=1000
PGID=1000

CLOUDFLARE_EMAIL=admin@example.com
TRAEFIK_ACME_CASERVER=https://acme-v02.api.letsencrypt.org/directory

# Cloudflare token: Zone Read and DNS Edit, scoped to the configured domain.
# In a local .env, single-quote values that contain literal dollar signs.
CLOUDFLARE_DNS_API_TOKEN=
PIHOLE_PASSWORD=

# Set tested image tags or immutable repository@sha256:... references. Portainer
# uses PORTAINER_IMAGE only in the CLI-managed bootstrap file.
# capture-image-pins.sh prints digests for an existing installation.
TRAEFIK_IMAGE=
PORTAINER_IMAGE=
PIHOLE_IMAGE=
NGINX_IMAGE=
DDCLIENT_IMAGE=
SOCKET_PROXY_IMAGE=
