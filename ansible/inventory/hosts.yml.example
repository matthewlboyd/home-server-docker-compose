all:
  children:
    homelab:
      hosts:
        server:
          ansible_host: 100.64.0.10
          ansible_user: ubuntu
          ansible_ssh_private_key_file: ~/.ssh/id_ed25519
      vars:
        # Ubuntu 26.04 defaults to sudo-rs, whose prompt is not yet compatible
        # with Ansible password-based privilege escalation.
        ansible_become_exe: /usr/bin/sudo.ws
        server_timezone: Etc/UTC
        lan_subnet: 192.0.2.0/24
