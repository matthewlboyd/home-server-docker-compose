# Copy this file to .env and replace the documentation-only values.
PIHOLE_IMAGE=pihole/pihole:2026.07.2
PIHOLE_DATA_DIR=./data/pihole
NPM_IMAGE=jc21/nginx-proxy-manager:2.15.1
PEANUT_IMAGE=brandawg93/peanut:6.0.0
LAN_IP=192.0.2.10
TZ=Etc/UTC
# Replace this example with your domain. Ansible reads this value from .env.
HOMELAB_DOMAIN=example.com
# Set automatically by the HTTPS playbook once using the public HTTPS name.
PEANUT_AUTH_URL=

# Private Docker bridge for NPM to reach the host-network PeaNUT web listener.
# This range must not overlap an existing LAN, VPN, or Docker network.
PEANUT_BRIDGE_SUBNET=172.29.20.0/29
PEANUT_BRIDGE_GATEWAY=172.29.20.1

# Existing names, followed by the LAN address. Compose also adds
# pihole, peanut, npm, and zomboid under ${HOMELAB_DOMAIN} to this record.
PIHOLE_HOST_RECORDS=server,server.home.arpa,pihole.home.arpa,192.0.2.10
